rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Admin authorization check: either via custom token claim or via an admin record
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.keys().hasAll(['admin']) && request.auth.token.admin == true) ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)))
      );
    }

    // 1. Users Collection
    // Users can read, create, update, and delete their own user profile document.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId) || isAdmin();
    }

    // 2. Usernames Collection (Handle Registry)
    // Anyone can read to check handle availability.
    // Authenticated users can claim or release their own handle.
    match /usernames/{username} {
      allow read: if true;
      allow create, update: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // 3. Apps Collection (Software Catalog)
    // Public users can read active and public apps.
    // Admins can manage all applications.
    match /apps/{appId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Subscriptions Collection (Product Quotas & Credits)
    // Users can read their own subscriptions and initialize default subscriptions.
    match /subscriptions/{subscriptionId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // 5. Entitlements Collection (Software Access Grants)
    match /entitlements/{entitlementId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // 6. Credit Logs Collection (Usage Ledger)
    match /credit_logs/{logId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 7. Account Tombstones (Anti-Abuse Ledger)
    match /account_tombstones/{tombstoneId} {
      allow read, write: if isAuthenticated();
    }

    // 8. Admins Collection
    match /admins/{adminId} {
      allow read: if isAuthenticated() && request.auth.uid == adminId;
      allow write: if false;
    }
  }
}
