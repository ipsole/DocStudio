rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Admin authorization check: via custom token claim, super admin email, or admins document
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.keys().hasAll(['admin']) && request.auth.token.admin == true) ||
        (request.auth.token.keys().hasAll(['email']) && request.auth.token.email == 'izackstudio1@gmail.com') ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)))
      );
    }

    // 1. Users Collection
    // Users can read, create, update, and delete their own user profile document.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId) || isAdmin();

      // Device Sessions Subcollection
      // Users can list, create, update, and remotely revoke sessions for their own account.
      match /sessions/{sessionId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // 2. Usernames Collection (Handle Registry)
    // Anyone can read to check handle availability.
    // Authenticated users can claim or release their own handle.
    match /usernames/{username} {
      allow read: if true;
      allow create, update: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // 3. Apps Collection (Software Catalog)
    // Public users can read active and public apps.
    // Admins can manage all applications.
    match /apps/{appId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Subscriptions Collection (Product Quotas & Credits)
    // Users can read their own subscriptions.
    // Client initialization allows creating starter free subscriptions only.
    // Plan upgrades and credit balance updates are reserved for server Admin SDK.
    match /subscriptions/{subscriptionId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (
        (request.resource.data.userId == request.auth.uid && request.resource.data.plan == 'free' && request.resource.data.creditsTotal <= 100) ||
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // 5. Entitlements Collection (Software Access Grants)
    match /entitlements/{entitlementId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // 6. Credit Logs Collection (Usage Ledger)
    match /credit_logs/{logId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 7. Account Tombstones (Anti-Abuse Ledger)
    match /account_tombstones/{tombstoneId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // 8. Admins Collection
    match /admins/{adminId} {
      allow read: if isAuthenticated() && request.auth.uid == adminId;
      allow write: if false;
    }

    // 9. Orders & Invoices Collection (Billing History)
    // Users can read their own purchase history.
    // Orders can only be created/updated by verified server Admin SDK.
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // 10. Coupons Collection (Promotional Codes)
    match /coupons/{couponId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 11. Coupon Redemptions Collection
    match /coupon_redemptions/{redemptionId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // 12. QR Login Sessions (Cross-Device Quick Sign-In)
    match /qr_logins/{sessionId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }
  }
}
