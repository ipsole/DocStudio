rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Admin authorization check: either via custom token claim or via an admin record
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.keys().hasAll(['admin']) && request.auth.token.admin == true) ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)))
      );
    }

    // 1. Users Collection
    // Users can read and update only their own profile.
    // They cannot assign themselves admin role or alter createdAt timestamps.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      
      allow create: if isOwner(userId) &&
        request.resource.data.uid == userId &&
        request.resource.data.email == request.auth.token.email &&
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false);

      allow update: if isOwner(userId) &&
        // Protect UID and immutable fields
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.email == resource.data.email &&
        // Prevent escalating privileges
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == resource.data.isAdmin);

      allow delete: if isAdmin();
    }

    // 2. Apps Collection (Software Catalog)
    // Public users can only read active or coming_soon products with visibility == 'public'.
    // Admins can read all (including drafts & archived) and write/update/delete.
    match /apps/{appId} {
      allow read: if (
        resource.data.visibility == 'public' && 
        (resource.data.status == 'active' || resource.data.status == 'coming_soon')
      ) || isAdmin();

      // Only authorized admins can create, modify, or delete catalog items
      allow create, update, delete: if isAdmin();
    }

    // 3. Entitlements Collection (Software Access Grants)
    // Users can read only their own active entitlements.
    // Client-side writing is STRICTLY forbidden: only server/Admin SDK can issue entitlements.
    match /entitlements/{entitlementId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if false; // Only Admin SDK (bypasses rules) can grant/revoke
    }

    // 4. Orders & Subscriptions (Future Billing Architecture)
    // Users can read only their own purchase history.
    // Client-side writing is STRICTLY forbidden: only server/Admin SDK can record purchases.
    match /orders/{orderId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if false;
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if false;
    }

    // 5. Admins Collection
    // Read only for the admin themselves or root; clients cannot write to admins collection.
    match /admins/{adminId} {
      allow read: if isAuthenticated() && request.auth.uid == adminId;
      allow write: if false; // Managed exclusively via Firebase CLI or server Admin SDK
    }
  }
}
