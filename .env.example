# ==============================================================================
# DOCSTUDIO / DOCDRIL ENVIRONMENT CONFIGURATION (.env)
# Copy this file to .env.local for local development.
# For Vercel Deployment: Configure these in Project Settings -> Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Base URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://docstudio.docdril.com

# ------------------------------------------------------------------------------
# 2. Client-Side Firebase Configuration (Required for browser app)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCFxuP2szj0N5KKArO5YXzTwr5SFm8mGGA
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=auth.docdril.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=docdril-softwares
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=docdril-softwares.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=994534391910
NEXT_PUBLIC_FIREBASE_APP_ID=1:994534391910:web:83fa3a9fa7281ba5056da7

# Demo Mode fallback (set to false in production if using purely live database)
NEXT_PUBLIC_ENABLE_DEMO_DATA=true

# ------------------------------------------------------------------------------
# 3. Google Identity Services (One Tap & Sign In with Google)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=994534391910-s87ohf60ip7lf6fdb99j3ifblmkshorp.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 4. Server-Side Firebase Admin Configuration (Vercel Serverless / Production)
# ------------------------------------------------------------------------------
# For Vercel: Set these 3 variables directly in the Vercel dashboard.
FIREBASE_ADMIN_PROJECT_ID=docdril-softwares
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-fbsvc@docdril-softwares.iam.gserviceaccount.com
# Paste the full RSA private key (with escaped \n or real newlines, both supported)
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional: Path to service account JSON (for local development only)
# GOOGLE_APPLICATION_CREDENTIALS=docdril-softwares-firebase-adminsdk-fbsvc-5a69c54be7.json

# ------------------------------------------------------------------------------
# 5. Internal API & Subdomain SSO Security
# ------------------------------------------------------------------------------
DOCSTORE_ADMIN_SECRET=docstore_admin_dev_secret_2026

# ------------------------------------------------------------------------------
# 6. Razorpay Payment Gateway (Live Mode Active)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_TtbxpyiMKn1eoh
RAZORPAY_KEY_SECRET=wKZZSpE4HlsQEJ7eCvEURYRq
RAZORPAY_WEBHOOK_SECRET=docstudio_live_webhook_secret_2026

# ------------------------------------------------------------------------------
# 7. Outbound Email Service (Hostinger SMTP for official electronic receipts)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@docdril.com
SMTP_PASSWORD=your_hostinger_smtp_password
SMTP_FROM="DocStudio" <billing@docdril.com>
