# ==============================================================================
# DOCSTORE ENVIRONMENT CONFIGURATION
# Docdril Central Software Platform
# Firebase Project: software-business
# ==============================================================================

# Client-Side Firebase Configuration (Required for browser app)
# Obtain these values from Firebase Console -> Project Settings -> General -> Your apps -> Web app
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=software-business.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=software-business
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=software-business.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Optional Demo Mode fallback (Allows browsing UI and demo data when Firebase env is not yet connected)
# Set to 'false' in production
NEXT_PUBLIC_ENABLE_DEMO_DATA=true

# Server-Side Firebase Admin Configuration (Privileged backend operations ONLY)
# Never expose these with NEXT_PUBLIC_ prefix!
# Generate a service account private key in Firebase Console -> Project Settings -> Service accounts
FIREBASE_ADMIN_PROJECT_ID=software-business
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@software-business.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Admin Provisioning Secret (Used for initial admin claim bootstrap if needed)
DOCSTORE_ADMIN_SECRET=
